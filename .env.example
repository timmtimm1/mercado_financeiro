# Copie pra .env (que é gitignored) e preencha com valores reais.
# .env nunca é commitado — cada pessoa/máquina tem o seu.

# Usado quando a pipeline passar a gravar num Postgres (Metabase lê daqui).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mercado_financeiro
POSTGRES_USER=mercado_financeiro
POSTGRES_PASSWORD=troque-por-uma-senha-forte-local
